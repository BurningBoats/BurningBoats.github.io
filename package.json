{
  "name": "burningboats-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Official website of Burning Boats Studios — Astro static site published to GitHub Pages (branch new-pages).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:check": "node scripts/import-assets.mjs --dry-run --strict",
    "fonts:build": "node scripts/build-fonts.mjs",
    "budgets": "node scripts/check-budgets.mjs",
    "verify": "npm run check && npm run build && npm run budgets"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@types/three": "^0.185.4",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.3.0",
    "fontkit": "^2.0.4",
    "opentype.js": "^2.0.0",
    "p-limit": "^7.3.1",
    "picocolors": "^1.1.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "svgo": "^4.0.2",
    "typescript": "^5.9.3"
  }
}
