---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import { SITE } from '~/config/site';
import { MINDARO } from '~/data/mindaro';
import { localeStaticPaths, useDict, type Locale } from '~/i18n';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useDict(locale);
const assets = (await getCollection('pressAssets')).sort((a, b) => a.data.order - b.data.order);
const previews = import.meta.glob<{ default: ImageMetadata }>('~/assets/press/*.webp', { eager: true });
const previewFor = (id?: string) => (id ? previews[`/src/assets/press/${id}.webp`]?.default : undefined);
const groups = assets.filter((a) => a.data.group !== 'bundle' && a.data.group !== 'docs');
const docs = assets.filter((a) => a.data.group === 'docs');
const mb = (b: number) => `${(b / 1024 / 1024).toFixed(1)} MB`;
const team = (await getCollection('team', (e) => e.data.active)).sort((a, b) => a.data.order - b.data.order);

const facts: [string, string][] = [
  [t.labels.developer, `${SITE.name} (${SITE.legalName})`],
  [t.labels.basedIn, t.labels.mexico],
  [t.labels.game, MINDARO.name],
  [t.labels.genre, t.labels.genreValue],
  [t.labels.players, `${t.labels.playersValue} · ${t.labels.coop}`],
  [t.labels.platform, t.labels.pcSteam],
  [t.labels.status, `${t.status.inDevelopment} · ${t.status.preLaunch}`],
  [t.labels.release, MINDARO.facts.release ?? t.labels.tbd],
  [t.labels.price, MINDARO.facts.price ?? t.labels.tbd],
  [t.labels.languages, MINDARO.facts.languages?.join(', ') ?? t.labels.tbd],
  [t.labels.pressContact, SITE.email],
];
const longDescription = [t.mindaro.about.p1, t.mindaro.about.p2, t.press.longP3].join('\n\n');
---
<BaseLayout locale={locale} title={t.seo.press.title} description={t.seo.press.description} current="press">
  <Section title={t.press.title} intro={t.press.intro} headingLevel="h1" width="wide">
    <div class="press-actions" data-reveal-item>
      <Button href={`mailto:${SITE.email}`} variant="secondary" icon="mail" iconPosition="start" size="lg">{t.common.cta.emailUs}</Button>
    </div>

    <div class="press-layout">
      <div class="press-main">
        <h2 class="press-h2" data-reveal-item>{t.press.assets}</h2>
        <ul class="press-grid">
          {groups.map((a) => {
            const pv = previewFor(a.data.preview);
            return (
              <li class="press-item" data-reveal-item>
                <a href={a.data.href} class="press-item-link" download>
                  <div class="press-preview">{pv ? <Image src={pv} alt="" width={640} loading="lazy" sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw" /> : <div class="press-preview-empty" />}</div>
                  <div class="press-item-body">
                    <h3>{a.data.title[locale]}</h3>
                    <p class="press-meta">{a.data.description?.[locale]} · ZIP · {mb(a.data.bytes)}</p>
                    <span class="press-dl"><Icon name="download" size={16} /> {t.common.cta.download}</span>
                  </div>
                </a>
              </li>
            );
          })}
          {docs.map((a) => (
            <li class="press-item press-item-doc" data-reveal-item>
              <a href={a.data.href} class="press-item-link" download>
                <div class="press-item-body">
                  <h3>{a.data.title[locale]}</h3>
                  <p class="press-meta">Markdown · {(a.data.bytes / 1024).toFixed(0)} KB</p>
                  <span class="press-dl"><Icon name="download" size={16} /> {t.common.cta.download}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>

        <h2 class="press-h2 mt-12" data-reveal-item>{t.press.descriptions}</h2>
        <div class="press-desc" data-reveal-item>
          <div class="press-desc-head"><h3>{t.press.shortLabel}</h3><button type="button" class="copy-btn" data-copy={t.press.short} data-copied-label={t.common.cta.copied} aria-label={t.press.copyText}><Icon name="copy" size={15} /> {t.press.copyText}</button></div>
          <p>{t.press.short}</p>
        </div>
        <div class="press-desc" data-reveal-item>
          <div class="press-desc-head"><h3>{t.press.longLabel}</h3><button type="button" class="copy-btn" data-copy={longDescription} data-copied-label={t.common.cta.copied} aria-label={t.press.copyText}><Icon name="copy" size={15} /> {t.press.copyText}</button></div>
          <p>{t.mindaro.about.p1}</p><p>{t.mindaro.about.p2}</p><p>{t.press.longP3}</p>
        </div>

        <h2 class="press-h2 mt-12" data-reveal-item>{t.press.features}</h2>
        <ul class="press-features" data-reveal-item>
          {t.mindaro.pillars.items.map((p) => <li><strong>{p.title}</strong> — {p.body}</li>)}
          {t.press.featuresExtra.map((f) => <li>{f}</li>)}
        </ul>

        <h2 class="press-h2 mt-12" data-reveal-item>{t.press.history}</h2>
        <p class="text-fg-muted" data-reveal-item>{t.press.historyBody}</p>
      </div>

      <aside class="press-side">
        <div class="factsheet" data-reveal-item>
          <h2 class="press-h2">{t.press.factSheet}</h2>
          <dl>
            {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v.includes('@') ? <a href={`mailto:${v}`}>{v}</a> : v}</dd></div>))}
            <div><dt>{t.labels.steam}</dt><dd><a href={MINDARO.steam.url} target="_blank" rel="noopener noreferrer">store.steampowered.com/app/{MINDARO.steam.appId}</a></dd></div>
            <div><dt>{t.labels.discord}</dt><dd><a href={MINDARO.discord.invite} target="_blank" rel="noopener noreferrer">{MINDARO.discord.invite.replace('https://', '')}</a></dd></div>
            <div><dt>{t.labels.social}</dt><dd><a href={SITE.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> · <a href={SITE.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></dd></div>
            <div><dt>{t.labels.monetization}</dt><dd>{t.press.monetizationValue}</dd></div>
          </dl>
        </div>
        <div class="factsheet" data-reveal-item>
          <h2 class="press-h2">{t.press.events}</h2>
          <ul class="plain">{t.press.eventsList.map((e) => <li><strong>{e.name}</strong> — {e.kind}</li>)}</ul>
        </div>
        <div class="factsheet" data-reveal-item>
          <h2 class="press-h2">{t.press.teamPhotos}</h2>
          <ul class="plain">{team.map((m) => <li><strong>{m.data.name}</strong> — {m.data.role[locale]}</li>)}</ul>
        </div>
        <div class="factsheet" data-reveal-item>
          <h2 class="press-h2">{t.press.usage}</h2>
          <p class="text-fg-muted">{t.press.logosUsage}</p>
        </div>
        <div class="factsheet" data-reveal-item>
          <h2 class="press-h2">{t.press.hashtags}</h2>
          <p class="hashtags">{MINDARO.hashtags.join(' ')}</p>
          <p class="text-fg-subtle text-sm mt-2">{t.press.hashtagsNote}</p>
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>

<style>
  .press-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 3rem; }
  .press-size { margin-left: 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.7; }
  .press-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(16rem, 1.4fr); gap: 3rem; align-items: start; }
  .press-h2 { font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.01em; margin-bottom: 1rem; }
  .press-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1.25rem; list-style: none; padding: 0; margin: 0; }
  .press-item { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-elevated); transition: transform var(--dur-base) var(--ease-out-cubic), border-color var(--dur-base); }
  .press-item:hover { transform: translateY(-2px); border-color: var(--fg-subtle); }
  .press-item-link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  .press-preview { aspect-ratio: 16 / 10; background: var(--navy-800); overflow: hidden; }
  .press-preview :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .press-preview-empty { width: 100%; height: 100%; }
  .press-item-body { display: flex; flex-direction: column; gap: 0.35rem; padding: 1rem 1.1rem 1.1rem; }
  .press-item-body h3 { font-size: 1.05rem; font-weight: 600; }
  .press-meta { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; color: var(--fg-subtle); }
  .press-dl { margin-top: 0.4rem; display: inline-flex; align-items: center; gap: 0.35rem; font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; }
  .press-item-doc .press-item-body { padding-top: 1.25rem; }
  .press-desc { padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); }
  .press-desc + .press-desc { margin-top: 1rem; }
  .press-desc-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.75rem; }
  .press-desc-head h3 { font-size: 1rem; font-weight: 600; }
  .press-desc p { color: var(--fg-muted); }
  .press-desc p + p { margin-top: 0.75rem; }
  .copy-btn { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.4rem 0.6rem; border-radius: var(--radius-xs); border: 1px solid var(--border); background: transparent; color: var(--fg-muted); font-size: 0.8rem; }
  .copy-btn:hover { color: var(--fg); border-color: var(--fg-muted); }
  .copy-btn[data-state='copied'] { color: var(--ok); border-color: var(--ok); }
  .press-features { list-style: disc; padding-left: 1.2rem; color: var(--fg-muted); display: grid; gap: 0.4rem; }
  .press-features strong { color: var(--fg); }
  .press-side { display: grid; gap: 1.5rem; position: sticky; top: calc(var(--nav-h) + 1rem); }
  .factsheet { padding: 1.25rem 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); }
  .factsheet dl div { display: grid; grid-template-columns: 7rem 1fr; gap: 0.75rem; padding: 0.45rem 0; border-bottom: 1px solid var(--border); font-size: 0.925rem; }
  .factsheet dl div:last-child { border-bottom: 0; }
  .factsheet dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--fg-subtle); padding-top: 0.15rem; }
  .factsheet dd a { color: var(--fg); }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; color: var(--fg-muted); font-size: 0.925rem; }
  .plain strong { color: var(--fg); }
  .hashtags { font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.7; color: var(--fg-muted); word-break: break-word; }
  @media (max-width: 63.999rem) { .press-layout { grid-template-columns: 1fr; } .press-side { position: static; } }
</style>
