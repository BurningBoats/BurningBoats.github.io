---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/layout/Section.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import HeroArt from '~/components/hero/HeroArt.astro';
import TrailerEmbed from '~/components/media/TrailerEmbed.astro';
import DiscordWidget from '~/components/social/DiscordWidget.astro';
import SteamCTA from '~/components/social/SteamCTA.astro';
import { MINDARO } from '~/data/mindaro';
import { localeStaticPaths, useDict, localePath, type Locale } from '~/i18n';
import { videoGameLd, organizationLd } from '~/lib/schema';
import keyartWide from '~/assets/mindaro/keyart-wide.webp';
import keyartTablet from '~/assets/mindaro/keyart-tablet.webp';
import keyartMobile from '~/assets/mindaro/keyart-mobile.webp';
import keyartPoster from '~/assets/mindaro/keyart-full.webp';
import wordmark from '~/assets/mindaro/mindaro-wordmark.png';
import denator from '~/assets/creatures/denator.webp';
import vorkula from '~/assets/creatures/vorkula.webp';
import bungus from '~/assets/creatures/bungus.webp';
import wadook from '~/assets/concept/wadook.webp';
import persecution from '~/assets/stills/persecution.webp';
import denatorChasing from '~/assets/stills/denator-chasing.webp';
import holdBloony from '~/assets/stills/hold-bloony.webp';
import withBungus from '~/assets/pioneer/with-bungus.webp';
import keyartFull from '~/assets/mindaro/keyart-full.webp';

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const t = useDict(locale);
const url = new URL(Astro.url.pathname, Astro.site).href;

const creatureArt: Record<string, ImageMetadata> = { denator, vorkula, bungus, wadook }; // hirustagua: only a sketch sheet exists — kept in copy, not shown
const poses = import.meta.glob<{ default: ImageMetadata }>('~/assets/pioneer/pose-0*.webp', { eager: true });
const poseList = Object.entries(poses).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m.default);
const gameplayPosters = import.meta.glob<{ default: ImageMetadata }>('~/assets/stills/gameplay-0*-poster.webp', { eager: true });
const clips = Object.entries(gameplayPosters).sort(([a], [b]) => a.localeCompare(b)).map(([, m], i) => ({ poster: m.default, n: i + 1 })).slice(0, 3);
const stills = [
  { img: persecution, alt: 'Pioneers running from a creature' },
  { img: denatorChasing, alt: 'A Denator chasing a pioneer' },
  { img: holdBloony, alt: 'A pioneer holding a bungus' },
];
---
<BaseLayout
  locale={locale}
  title={t.seo.mindaro.title}
  description={t.seo.mindaro.description}
  ogTitle={t.seo.mindaro.ogTitle}
  image="/og/mindaro.jpg"
  imageAlt="Mindaro key art"
  current="mindaro"
  navVariant="overlay"
  jsonLd={[organizationLd(), videoGameLd(locale, t.seo.mindaro.description, url, '/og/mindaro.jpg')]}
>
  <div data-scope="mindaro">
    <!-- HERO -->
    <section class="hero theme-dark" data-embers-wrap data-parallax-root>
      <HeroArt wide={keyartWide} tablet={keyartTablet} mobile={keyartMobile} vignette="center" parallax={8} />
      <canvas class="hero-embers fx-only" data-embers aria-hidden="true"></canvas>
      <div class="container-x hero-inner">
        <h1 class="hero-wordmark hero-in" style="--i:0"><Image src={wordmark} alt="Mindaro" width={720} densities={[1, 2]} loading="eager" fetchpriority="high" /></h1>
        <p class="hero-tagline hero-in" style="--i:1">{t.mindaro.tagline}</p>
        <p class="hero-sub hero-in" style="--i:2">{t.mindaro.oneLiner}</p>
        <ul class="stats hero-in" style="--i:3">
          {t.mindaro.stats.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
        </ul>
        <div class="hero-ctas hero-in" style="--i:4">
          <Button href={MINDARO.steam.url} external variant="mindaro" icon="steam" iconPosition="start" size="lg" magnetic>{t.common.cta.wishlist}</Button>
          <Button href={MINDARO.discord.invite} external variant="secondary" icon="discord" iconPosition="start" size="lg">{t.common.cta.discord}</Button>
          <a href="#trailer" class="hero-trailer-link">{MINDARO.media.youtubeId ? t.common.cta.watchTrailer : t.mindaro.trailer.soonPill} <Icon name="chevron-down" size={16} /></a>
        </div>
      </div>
    </section>

    <!-- TRAILER -->
    <Section id="trailer" eyebrow={t.mindaro.trailer.title} width="default" bg="sunken">
      <div data-reveal-item><TrailerEmbed locale={locale} poster={keyartPoster} /></div>
    </Section>

    <!-- ABOUT -->
    <Section id="about" eyebrow={t.mindaro.about.eyebrow} title={t.mindaro.about.title} width="wide">
      <div class="about">
        <div class="about-copy">
          <p data-reveal-item>{t.mindaro.about.p1}</p>
          <p data-reveal-item>{t.mindaro.about.p2}</p>
          <ol class="verbs">
            {t.mindaro.verbs.map((v, i) => (
              <li data-reveal-item>
                <span class="verb-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="verb-word mindaro-face">{v.verb}</span>
                <span class="verb-line">{v.line}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="about-figure" data-reveal-item aria-hidden="true">
          <Image src={withBungus} alt="" width={460} densities={[1, 2]} loading="lazy" />
        </div>
      </div>
    </Section>

    <!-- PILLARS -->
    <Section id="pillars" eyebrow={t.mindaro.pillars.eyebrow} title={t.mindaro.pillars.title} bg="sunken">
      <ul class="pillars">
        {t.mindaro.pillars.items.map((p) => (
          <li data-reveal-item>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </Section>

    <!-- DESCENT (biomes) -->
    <section id="descent" class="descent theme-dark section-y" data-reveal>
      <div class="descent-bg" aria-hidden="true"><Image src={keyartFull} alt="" width={1920} loading="lazy" sizes="100vw" data-parallax="14" /></div>
      <div class="container-x descent-inner">
        <header class="descent-head" data-reveal-item>
          <p class="eyebrow">{t.mindaro.descent.eyebrow}</p>
          <h2 class="section-title">{t.mindaro.descent.title}</h2>
          <p class="section-intro">{t.mindaro.descent.body}</p>
        </header>
        <ol class="biomes" data-reveal-item>
          {MINDARO.biomes.map((b, i) => (
            <li style={`--i:${i}`}>
              <span class="biome-depth">{t.mindaro.descent.depthLabel} {String(i + 1).padStart(2, '0')}</span>
              <span class="biome-name mindaro-face">{b}</span>
            </li>
          ))}
          <li class="biome-more"><span class="biome-name">{t.mindaro.descent.more}</span></li>
        </ol>
      </div>
    </section>

    <!-- CREATURES -->
    <Section id="creatures" eyebrow={t.mindaro.creatures.eyebrow} title={t.mindaro.creatures.title} width="wide">
      <ul class="creatures">
        {t.mindaro.creatures.items.filter((c) => creatureArt[c.id]).map((c) => (
          <li data-reveal-item>
            <div class="creature-art">
              {creatureArt[c.id] && <Image src={creatureArt[c.id]} alt={c.name} width={800} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw" loading="lazy" />}
            </div>
            <h3 class="creature-name mindaro-face">{c.name}</h3>
            <p class="creature-line">{c.line}</p>
          </li>
        ))}
      </ul>
      <p class="creatures-closer" data-reveal-item>{t.mindaro.creatures.closer}</p>
    </Section>

    <!-- SCREENSHOTS -->
    <Section id="screenshots" eyebrow={t.mindaro.screenshots.eyebrow} title={t.mindaro.screenshots.title} intro={t.mindaro.screenshots.empty} bg="sunken" width="wide">
      <div class="shots">
        {stills.map((s) => (
          <figure class="shot" data-reveal-item>
            <Image src={s.img} alt={s.alt} width={1200} sizes="(min-width: 64rem) 45vw, 100vw" loading="lazy" />
            <figcaption class="shot-badge">{t.mindaro.screenshots.badge}</figcaption>
          </figure>
        ))}
        {clips.map((c) => (
          <figure class="shot shot-video" data-reveal-item data-ambient-wrap>
            <video data-ambient muted loop playsinline preload="none" poster={c.poster.src} width={c.poster.width} height={c.poster.height} aria-label={t.mindaro.screenshots.badge}>
              <source src={`/video/gameplay-0${c.n}.webm`} type="video/webm" />
              <source src={`/video/gameplay-0${c.n}.mp4`} type="video/mp4" />
            </video>
            <figcaption class="shot-badge">{t.mindaro.screenshots.badge}</figcaption>
            <button type="button" class="shot-toggle" data-ambient-toggle aria-label={t.common.a11y.pauseVideo}><Icon name="pause" size={14} /></button>
          </figure>
        ))}
      </div>
    </Section>

    <!-- PIONEERS: pose reel -->
    <Section id="pioneers" width="wide">
      <div class="reel-wrap">
        <div class="reel-copy">
          <p class="eyebrow" data-reveal-item>{t.mindaro.pioneers.eyebrow}</p>
          <h2 class="section-title" data-reveal-item>{t.mindaro.pioneers.title}</h2>
          <p class="section-intro" data-reveal-item>{t.mindaro.pioneers.body}</p>
        </div>
        <div class="reel" data-reel data-reveal-item>
          <div class="reel-screen">
            {poseList.map((p, i) => (
              <div class="reel-frame" data-reel-frame hidden={i !== 0}>
                <Image src={p} alt={`Pioneer pose ${i + 1}`} width={696} height={464} loading="lazy" />
              </div>
            ))}
            <div class="reel-scan" aria-hidden="true"></div>
            <span class="reel-label" data-reel-label aria-hidden="true">CAM 01/{String(poseList.length).padStart(2, '0')}</span>
          </div>
          <div class="reel-controls">
            <button type="button" data-reel-prev aria-label={t.common.a11y.prev}><Icon name="chevron-right" size={18} class="rotate-180" /></button>
            <button type="button" data-reel-next aria-label={t.common.a11y.next}><Icon name="chevron-right" size={18} /></button>
          </div>
        </div>
      </div>
    </Section>

    <!-- ORIGINS + STATUS -->
    <Section id="origins" bg="sunken">
      <div class="two-col">
        <div data-reveal-item>
          <p class="eyebrow">{t.mindaro.origins.eyebrow}</p>
          <h2 class="section-title mt-4">{t.mindaro.origins.title}</h2>
          <p class="mt-5 text-fg-muted text-lg">{t.mindaro.origins.body}</p>
        </div>
        <div data-reveal-item>
          <p class="eyebrow">{t.mindaro.devStatus.eyebrow}</p>
          <h2 class="section-title mt-4">{t.mindaro.devStatus.title}</h2>
          <ul class="badges mt-4">{t.mindaro.devStatus.badges.map((b) => <li>{b}</li>)}</ul>
          <p class="mt-5 text-fg-muted text-lg">{t.mindaro.devStatus.body}</p>
        </div>
      </div>
    </Section>

    <!-- COMMUNITY -->
    <Section id="community" eyebrow={t.mindaro.community.eyebrow} title={t.mindaro.community.title}>
      <div class="community">
        <div data-reveal-item><DiscordWidget locale={locale} /></div>
        <div data-reveal-item><SteamCTA locale={locale} variant="card" buttonVariant="mindaro" body={t.home.hero.micro} /></div>
      </div>
    </Section>

    <!-- FAQ -->
    <Section id="faq" title={t.mindaro.faq.title} width="narrow" bg="sunken">
      <dl class="faq">
        {t.mindaro.faq.items.map((f) => (
          <div data-reveal-item>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <!-- FINAL CTA -->
    <Section id="wishlist" theme="dark" align="center" width="narrow">
      <h2 class="cta-title" data-reveal-item>{t.mindaro.ctaFooter.title}</h2>
      <p class="mt-3 text-fg-muted" data-reveal-item>{t.mindaro.ctaFooter.sub}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3" data-reveal-item>
        <Button href={MINDARO.steam.url} external variant="mindaro" icon="steam" iconPosition="start" size="lg" magnetic>{t.common.cta.wishlist}</Button>
        <Button href={MINDARO.discord.invite} external variant="secondary" icon="discord" iconPosition="start" size="lg">{t.common.cta.discord}</Button>
      </div>
      <p class="mt-8 text-sm text-fg-subtle" data-reveal-item>{t.mindaro.pressLine} <a href={localePath(locale, 'press')} class="underline">{t.common.cta.pressKit}</a></p>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: clip; background: var(--navy-950); color: var(--cream-50); }
  .hero-embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  .hero-inner { position: relative; z-index: 2; padding-top: calc(var(--nav-h) + 3rem); padding-bottom: clamp(4rem, 10vh, 7rem); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hero-wordmark { width: min(78vw, 640px); }
  .hero-wordmark :global(img) { width: 100%; height: auto; filter: drop-shadow(0 12px 40px rgb(0 0 0 / 0.6)); }
  .hero-tagline { margin-top: 1.75rem; font-family: var(--font-mono); font-size: clamp(0.85rem, 1.5vw, 1.05rem); letter-spacing: 0.06em; color: var(--m-yellow); max-width: 40ch; }
  .hero-sub { margin-top: 1rem; font-size: var(--text-lg); color: var(--slate-200); max-width: 50ch; }
  .stats { display: flex; justify-content: center; flex-wrap: wrap; margin: 2rem 0 0; padding: 0; list-style: none; border: 1px solid color-mix(in oklab, var(--cream-50) 25%, transparent); border-radius: var(--radius-md); overflow: hidden; background: color-mix(in oklab, var(--navy-950) 55%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .stats li { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; padding: 0.8rem 1.4rem; border-right: 1px solid color-mix(in oklab, var(--cream-50) 18%, transparent); }
  .stats li:last-child { border-right: 0; }
  .stats strong { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.01em; }
  .stats span { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--slate-300); }
  .hero-ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.25rem; margin-top: 2.25rem; }
  .hero-trailer-link { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--slate-200); text-decoration: none; font-size: 0.95rem; }
  .hero-trailer-link:hover { color: var(--cream-50); }
  @media (max-width: 40rem) { .stats li { padding: 0.6rem 0.9rem; } }

  .about { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 3rem; align-items: start; }
  .about-copy > p { font-size: var(--text-lg); color: var(--fg-muted); max-width: 60ch; }
  .about-copy > p + p { margin-top: 1rem; }
  .about-figure { justify-self: center; }
  .about-figure :global(img) { width: min(100%, 380px); height: auto; filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.45)); }
  .verbs { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--border); }
  .verbs li { display: grid; grid-template-columns: 3rem minmax(9rem, 12rem) 1fr; align-items: baseline; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--border); }
  .verb-index { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; color: var(--m-orange); }
  .verb-word { font-size: var(--text-xl); letter-spacing: 0.02em; }
  .verb-line { color: var(--fg-muted); }
  @media (max-width: 63.999rem) { .about { grid-template-columns: 1fr; } .about-figure { display: none; } .verbs li { grid-template-columns: 3rem 1fr; } .verb-line { grid-column: 2; } }

  .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.25rem; list-style: none; padding: 0; margin: 0; }
  .pillars li { padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elevated); border-top: 2px solid var(--m-yellow); }
  .pillars h3 { font-size: var(--text-lg); }
  .pillars p { margin-top: 0.5rem; color: var(--fg-muted); }

  .descent { position: relative; overflow: hidden; }
  .descent-bg { position: absolute; inset: -10% 0; z-index: 0; opacity: 0.22; filter: saturate(0.7); }
  .descent-bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .descent::before { content: ''; position: absolute; inset: 0; z-index: 0; background: linear-gradient(180deg, var(--navy-900) 0%, transparent 25%, transparent 75%, var(--navy-950) 100%); }
  .descent-inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 3rem; align-items: start; }
  .descent-head { max-width: 40rem; }
  .descent-head .section-title { margin-top: 1rem; }
  .biomes { list-style: none; margin: 0; padding: 0; position: relative; }
  .biomes::before { content: ''; position: absolute; left: 0.45rem; top: 0.5rem; bottom: 2rem; width: 1px; background: linear-gradient(180deg, var(--m-yellow), var(--m-orange) 60%, transparent); }
  .biomes li { position: relative; display: flex; align-items: baseline; gap: 1.25rem; padding: 0.55rem 0 0.55rem 2rem; }
  .biomes li::before { content: ''; position: absolute; left: 0; top: 0.95rem; width: 0.9rem; height: 0.9rem; border-radius: 50%; border: 1px solid var(--m-yellow); background: var(--navy-950); }
  .biome-depth { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--slate-300); min-width: 6rem; }
  .biome-name { font-size: clamp(1.25rem, 2.6vw, 1.75rem); color: var(--cream-50); }
  .biome-more .biome-name { font-family: var(--font-body); font-style: italic; font-size: 1rem; color: var(--slate-300); }
  .biome-more::before { display: none; }
  @media (max-width: 63.999rem) { .descent-inner { grid-template-columns: 1fr; } }

  .creatures { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 64rem) { .creatures { grid-template-columns: repeat(4, 1fr); } }
  .creatures li { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.25rem; border-radius: var(--radius-lg); background: linear-gradient(180deg, var(--m-brown-900), var(--m-brown-950)); border: 1px solid color-mix(in oklab, var(--m-brown-800) 80%, transparent); color: var(--m-cream); }
  .creature-art { aspect-ratio: 4 / 3; display: grid; place-items: center; overflow: hidden; border-radius: var(--radius-md); background: radial-gradient(60% 60% at 50% 60%, color-mix(in oklab, var(--m-brown-800) 60%, transparent), transparent); }
  .creature-art :global(img) { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 12px 24px rgb(0 0 0 / 0.5)); transition: transform 0.6s var(--ease-out-cubic); }
  .creatures li:hover .creature-art :global(img) { transform: scale(1.04); }
  .creature-name { font-size: var(--text-xl); letter-spacing: 0.03em; color: var(--m-yellow); }
  .creature-line { color: color-mix(in oklab, var(--m-cream) 80%, transparent); }
  .creatures-closer { margin-top: 1.5rem; color: var(--fg-subtle); font-style: italic; }

  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.25rem; }
  @media (min-width: 64rem) { .shots { grid-template-columns: repeat(3, 1fr); } }
  .shot { position: relative; margin: 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: var(--bg-elevated); }
  .shot :global(img), .shot video { width: 100%; height: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
  .shot-badge { position: absolute; left: 0.75rem; bottom: 0.75rem; padding: 0.3rem 0.55rem; border-radius: var(--radius-xs); background: color-mix(in oklab, var(--navy-950) 78%, transparent); color: var(--cream-50); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .shot-toggle { position: absolute; right: 0.75rem; bottom: 0.75rem; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid color-mix(in oklab, var(--cream-50) 40%, transparent); background: color-mix(in oklab, var(--navy-950) 70%, transparent); color: var(--cream-50); }

  .reel-wrap { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 3rem; align-items: center; }
  .reel-copy .section-title { margin-top: 1rem; }
  .reel-copy .section-intro { margin-top: 1rem; font-size: var(--text-lg); color: var(--fg-muted); }
  .reel { display: grid; gap: 0.75rem; }
  .reel-screen { position: relative; aspect-ratio: 3 / 2; border-radius: var(--radius-lg); overflow: hidden; background: var(--cream-50); border: 6px solid var(--navy-800); box-shadow: inset 0 0 0 1px var(--border), var(--shadow-2); }
  .reel-frame { position: absolute; inset: 0; }
  .reel-frame[hidden] { display: none; }
  .reel-frame :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .reel-scan { position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, transparent 0 2px, rgb(0 0 0 / 0.08) 2px 3px); mix-blend-mode: multiply; }
  .reel-label { position: absolute; top: 0.6rem; left: 0.75rem; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; color: var(--navy-900); }
  .reel-controls { display: flex; gap: 0.5rem; justify-content: flex-end; }
  .reel-controls button { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-sm); border: 1px solid var(--border-strong); background: transparent; color: var(--fg); }
  .reel-controls button:hover { background: var(--bg-elevated); }
  @media (max-width: 63.999rem) { .reel-wrap { grid-template-columns: 1fr; } }

  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 3rem; }
