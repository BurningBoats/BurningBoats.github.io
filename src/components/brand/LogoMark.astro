---
/**
 * The paper-boat mark (BBS_LOGO.svg, cleaned) in its ORIGINAL colors: navy flame + water,
 * black outline, cream boat. Never recolored.
 *  - scheme="brand" (default): the artwork as-is — for cream/light surfaces.
 *  - scheme="tile": the artwork on a cream rounded tile — for navy/dark surfaces (like Logo3.png).
 *  - scheme="mono": single-color line version (currentColor) — decorative ghost use only.
 */
import Mark from '~/assets/brand/bbs-mark.svg';

interface Props {
  size?: number | string;
  class?: string;
  scheme?: 'brand' | 'tile' | 'mono';
  /** tile shape */
  shape?: 'circle' | 'rounded';
  title?: string;
}
const { size = 40, class: className, scheme = 'brand', shape = 'rounded', title } = Astro.props;
const px = typeof size === 'number' ? `${size}px` : size;
---
<span
  class:list={['logo-mark', `logo-${scheme}`, `logo-shape-${shape}`, className]}
  style={`--logo-size:${px}`}
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  aria-label={title}
>
  <Mark width="100%" height="100%" />
</span>

<style>
  .logo-mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--logo-size);
    height: var(--logo-size);
    flex: none;
    /* original artwork colors — do not theme */
    --logo-navy: #10212e;
    --logo-ink: #020202;
    --logo-paper: #fffaf1;
    --logo-shade: #8a8a8a;
  }
  .logo-mark :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }

  /* Cream tile behind the mark for dark surfaces (the mark keeps ~78% of the tile) */
  .logo-tile { background: #fffaf1; border-radius: 22%; box-shadow: inset 0 0 0 1px rgb(2 2 2 / 0.06), 0 6px 18px -8px rgb(0 0 0 / 0.5); }
  .logo-tile.logo-shape-circle { border-radius: 50%; }
  .logo-tile :global(svg) { width: 84%; height: 84%; }

  .logo-mono {
    --logo-navy: currentColor;
    --logo-ink: currentColor;
    --logo-paper: transparent;
    --logo-shade: currentColor;
  }
</style>
