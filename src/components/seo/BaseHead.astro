---
import { Font } from 'astro:assets';
import { SITE, SITE_URL } from '~/config/site';
import { LOCALES, DEFAULT_LOCALE, localeMeta, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Absolute or site-relative URL of the 1200×630 social image */
  image?: string;
  imageAlt?: string;
  ogTitle?: string;
  type?: 'website' | 'article';
  /** Sibling URLs per locale (site-relative). Missing locales are omitted from hreflang. */
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  locale,
  title,
  description,
  image = '/og/site.jpg',
  imageAlt = 'Burning Boats Studios',
  ogTitle,
  type = 'website',
  alternates,
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site).href;
const alt = alternates ?? {};
const altEntries = LOCALES.filter((l) => alt[l]).map((l) => ({ locale: l, href: new URL(alt[l]!, site).href }));
const xDefault = alt[DEFAULT_LOCALE] ? new URL(alt[DEFAULT_LOCALE]!, site).href : undefined;
const otherLocales = LOCALES.filter((l) => l !== locale);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0e1b24" data-theme-color />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{altEntries.map(({ locale: l, href }) => <link rel="alternate" hreflang={localeMeta[l].hreflang} href={href} />)}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={localeMeta[locale].og} />
{otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMeta[l].og} />)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — News`} href={new URL(locale === DEFAULT_LOCALE ? '/rss.xml' : `/${locale}/rss.xml`, site).href} />

<Font cssVariable="--ff-display" preload />
<Font cssVariable="--ff-body" preload />
<Font cssVariable="--ff-mono" />
<Font cssVariable="--ff-mindaro" />
