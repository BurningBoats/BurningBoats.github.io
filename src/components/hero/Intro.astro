---
/**
 * Logo intro (Home only, once per session, ≤1.5 s). Pure CSS keyframes so it starts at first paint;
 * `html[data-intro="seen"]` (set pre-paint from sessionStorage) hides it entirely on later visits.
 * Any key/tap skips. Respects reduced motion (plain fade). Fire flicker only when effects are on.
 */
import { SITE } from '~/config/site';
import { useDict, type Locale } from '~/i18n';
import LogoMark from '~/components/brand/LogoMark.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useDict(locale);
---
{SITE.effects.preloader && (
  <div class="intro theme-dark" data-intro-overlay aria-hidden="true">
    <div class="intro-mark"><LogoMark size="clamp(140px, 22vw, 220px)" scheme="tile" /></div>
    <p class="intro-name">Burning Boats Studios</p>
    <button type="button" class="intro-skip" data-intro-skip tabindex="-1">{t.common.cta.skipIntro}</button>
  </div>
)}

<style>
  .intro {
    position: fixed; inset: 0; z-index: var(--z-intro);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.25rem;
    background: var(--navy-900);
    animation: intro-out 0.35s var(--ease-in-out) 1.1s both;
    pointer-events: auto;
  }
  :global(html[data-intro='seen']) .intro, .intro.is-done { display: none; }
  /* Desktop-only: on phones the intro would only delay the first meaningful paint. */
  @media (max-width: 767px) { .intro { display: none; } }
  .intro.is-skipped { animation: intro-out 0.2s var(--ease-in-out) 0s both; }

  .intro-mark :global(.logo-water) { animation: wipe-x 0.45s var(--ease-out-cubic) 0s both; }
  .intro-mark :global(.logo-boat)  { animation: wipe-up 0.55s var(--ease-out-expo) 0.15s both; }
  .intro-mark :global(.logo-flame) { animation: wipe-up 0.5s var(--ease-out-cubic) 0.45s both; transform-origin: 50% 100%; }
  :global([data-effects='on']) .intro-mark :global(.logo-flame) { animation: wipe-up 0.5s var(--ease-out-cubic) 0.45s both, flicker 0.35s ease-in-out 0.95s 1; }
  .intro-name { font-family: var(--font-display); font-weight: 600; letter-spacing: 0.02em; font-size: 0.95rem; color: var(--slate-200); animation: fade-in 0.4s ease-out 0.55s both; }
  .intro-skip { position: absolute; bottom: 1.5rem; right: 1.5rem; padding: 0.4rem 0.7rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: transparent; color: var(--fg-muted); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; animation: fade-in 0.3s ease-out 0.4s both; }

  @keyframes wipe-x   { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes wipe-up  { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes flicker  { 0%, 100% { opacity: 1; transform: skewX(0); } 30% { opacity: 0.78; transform: skewX(1.5deg); } 60% { opacity: 0.92; transform: skewX(-1deg); } }
  @keyframes fade-in  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes intro-out { from { opacity: 1; visibility: visible; } to { opacity: 0; visibility: hidden; } }

  @media (prefers-reduced-motion: reduce) {
    .intro { animation: intro-out 0.25s ease-out 0.15s both; }
    .intro-mark :global(.logo-water), .intro-mark :global(.logo-boat), .intro-mark :global(.logo-flame), .intro-name, .intro-skip { animation: none; }
  }
</style>
